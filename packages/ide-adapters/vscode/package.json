{
  "name": "multilingual-code",
  "displayName": "Babel TCC - MultiLingual Code",
  "description": "%description%",
  "version": "1.1.0",
  "publisher": "NFAsylum",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/NFAsylum/babel-tcc"
  },
  "bugs": {
    "url": "https://github.com/NFAsylum/babel-tcc/issues"
  },
  "homepage": "https://github.com/NFAsylum/babel-tcc#readme",
  "keywords": [
    "multilingual",
    "translation",
    "localization",
    "i18n",
    "csharp",
    "python",
    "javascript",
    "portuguese",
    "education",
    "keywords"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Education"
  ],
  "activationEvents": [
    "onLanguage:csharp",
    "onLanguage:python",
    "onLanguage:visualg",
    "onLanguage:portugol-studio",
    "onLanguage:javascript",
    "onFileSystem:babel-tcc-translated",
    "onFileSystem:babel-tcc-readonly"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "babel-tcc.toggle",
        "title": "%command.toggle.title%",
        "category": "%extension.category%"
      },
      {
        "command": "babel-tcc.selectLanguage",
        "title": "%command.selectLanguage.title%",
        "category": "%extension.category%"
      },
      {
        "command": "babel-tcc.openTranslatedEditable",
        "title": "%command.openTranslatedEditable.title%",
        "shortTitle": "%command.openTranslatedEditable.shortTitle%",
        "category": "%extension.category%",
        "icon": "$(globe)"
      },
      {
        "command": "babel-tcc.openTranslatedReadonly",
        "title": "%command.openTranslatedReadonly.title%",
        "category": "%extension.category%"
      },
      {
        "command": "babel-tcc.showOriginal",
        "title": "%command.showOriginal.title%",
        "shortTitle": "%command.showOriginal.shortTitle%",
        "category": "%extension.category%",
        "icon": "$(file-code)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "babel-tcc.openTranslatedEditable",
          "when": "config.babel-tcc.enabled && resourceExtname =~ /^\\.(cs|py|alg|por|js)$/i && resourceScheme != 'babel-tcc-translated' && resourceScheme != 'babel-tcc-readonly'",
          "group": "navigation@1"
        },
        {
          "command": "babel-tcc.showOriginal",
          "when": "resourceScheme =~ /^(babel-tcc-translated|babel-tcc-readonly)$/",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "babel-tcc.openTranslatedEditable",
          "when": "config.babel-tcc.enabled && resourceExtname =~ /^\\.(cs|py|alg|por|js)$/i && resourceScheme != 'babel-tcc-translated' && resourceScheme != 'babel-tcc-readonly'",
          "group": "babel-tcc@1"
        },
        {
          "command": "babel-tcc.openTranslatedReadonly",
          "when": "config.babel-tcc.enabled && resourceExtname =~ /^\\.(cs|py|alg|por|js)$/i && resourceScheme != 'babel-tcc-translated' && resourceScheme != 'babel-tcc-readonly'",
          "group": "babel-tcc@2"
        },
        {
          "command": "babel-tcc.showOriginal",
          "when": "resourceScheme =~ /^(babel-tcc-translated|babel-tcc-readonly)$/",
          "group": "babel-tcc@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "babel-tcc.toggle",
        "key": "ctrl+alt+u t",
        "mac": "cmd+alt+u t"
      },
      {
        "command": "babel-tcc.selectLanguage",
        "key": "ctrl+alt+u i",
        "mac": "cmd+alt+u i"
      },
      {
        "command": "babel-tcc.openTranslatedEditable",
        "key": "ctrl+alt+u v",
        "mac": "cmd+alt+u v",
        "when": "editorTextFocus && config.babel-tcc.enabled && resourceExtname =~ /^\\.(cs|py|alg|por|js)$/i && resourceScheme != 'babel-tcc-translated' && resourceScheme != 'babel-tcc-readonly'"
      },
      {
        "command": "babel-tcc.showOriginal",
        "key": "ctrl+alt+u o",
        "mac": "cmd+alt+u o",
        "when": "editorTextFocus && resourceScheme =~ /^(babel-tcc-translated|babel-tcc-readonly)$/"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "babel-tcc.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.enabled.description%",
          "order": 1
        },
        "babel-tcc.language": {
          "type": "string",
          "default": "pt-br",
          "description": "%config.language.description%",
          "order": 2,
          "enum": ["pt-br", "pt-br-ascii", "en-us", "es-es", "fr-fr", "de-de", "it-it", "ja-jp-romaji", "zh-cn", "ar-sa"],
          "enumItemLabels": ["Português (Brasil)", "Português (Brasil, sem acentos)", "English (US)", "Español", "Français", "Deutsch", "Italiano", "日本語 (romaji)", "中文 (简体)", "العربية"],
          "enumDescriptions": ["%config.language.enum.ptBr%", "%config.language.enum.ptBrAscii%", "%config.language.enum.enUs%", "%config.language.enum.esEs%", "%config.language.enum.frFr%", "%config.language.enum.deDe%", "%config.language.enum.itIt%", "%config.language.enum.jaJpRomaji%", "%config.language.enum.zhCn%", "%config.language.enum.arSa%"]
        },
        "babel-tcc.languageOverrides": {
          "type": "object",
          "default": {},
          "description": "%config.languageOverrides.description%",
          "order": 3,
          "properties": {
            "CSharp": {
              "type": "string",
              "description": "%config.languageOverrides.csharp.description%",
              "enum": ["pt-br", "pt-br-ascii", "en-us", "es-es", "fr-fr", "de-de", "it-it", "ja-jp-romaji", "zh-cn", "ar-sa"],
              "enumItemLabels": ["Português (Brasil)", "Português (Brasil, sem acentos)", "English (US)", "Español", "Français", "Deutsch", "Italiano", "日本語 (romaji)", "中文 (简体)", "العربية"]
            },
            "Python": {
              "type": "string",
              "description": "%config.languageOverrides.python.description%",
              "enum": ["pt-br", "pt-br-ascii", "en-us", "es-es", "fr-fr", "de-de", "it-it", "ja-jp-romaji", "zh-cn", "ar-sa"],
              "enumItemLabels": ["Português (Brasil)", "Português (Brasil, sem acentos)", "English (US)", "Español", "Français", "Deutsch", "Italiano", "日本語 (romaji)", "中文 (简体)", "العربية"]
            },
            "VisuAlg": {
              "type": "string",
              "description": "%config.languageOverrides.visualg.description%",
              "enum": ["pt-br", "pt-br-ascii", "en-us", "es-es", "fr-fr", "de-de", "it-it", "ja-jp-romaji", "zh-cn", "ar-sa"],
              "enumItemLabels": ["Português (Brasil)", "Português (Brasil, sem acentos)", "English (US)", "Español", "Français", "Deutsch", "Italiano", "日本語 (romaji)", "中文 (简体)", "العربية"]
            },
            "PortugolStudio": {
              "type": "string",
              "description": "%config.languageOverrides.portugolStudio.description%",
              "enum": ["pt-br", "pt-br-ascii", "en-us", "es-es", "fr-fr", "de-de", "it-it", "ja-jp-romaji", "zh-cn", "ar-sa"],
              "enumItemLabels": ["Português (Brasil)", "Português (Brasil, sem acentos)", "English (US)", "Español", "Français", "Deutsch", "Italiano", "日本語 (romaji)", "中文 (简体)", "العربية"]
            },
            "JavaScript": {
              "type": "string",
              "description": "%config.languageOverrides.javascript.description%",
              "enum": ["pt-br", "pt-br-ascii", "en-us", "es-es", "fr-fr", "de-de", "it-it", "ja-jp-romaji", "zh-cn", "ar-sa"],
              "enumItemLabels": ["Português (Brasil)", "Português (Brasil, sem acentos)", "English (US)", "Español", "Français", "Deutsch", "Italiano", "日本語 (romaji)", "中文 (简体)", "العربية"]
            }
          },
          "additionalProperties": false
        },
        "babel-tcc.readonly": {
          "type": "boolean",
          "default": false,
          "description": "%config.readonly.description%",
          "order": 4
        },
        "babel-tcc.translationsPath": {
          "type": "string",
          "default": "",
          "description": "%config.translationsPath.description%",
          "order": 5
        }
      }
    },
    "semanticTokenScopes": [
      {
        "scopes": {
          "keywordControl": ["keyword.control"],
          "keywordType": ["storage.type"],
          "keywordModifier": ["storage.modifier"],
          "keywordLiteral": ["constant.language"],
          "keywordOther": ["keyword.other"]
        }
      }
    ],
    "grammars": [
      {
        "language": "visualg",
        "scopeName": "source.visualg",
        "path": "./syntaxes/visualg.tmLanguage.json"
      },
      {
        "language": "portugol-studio",
        "scopeName": "source.portugol-studio",
        "path": "./syntaxes/portugol-studio.tmLanguage.json"
      }
    ],
    "languages": [
      {
        "id": "visualg",
        "aliases": [
          "VisuAlg",
          "visualg"
        ],
        "extensions": [
          ".alg"
        ],
        "configuration": "./syntaxes/visualg.language-configuration.json"
      },
      {
        "id": "portugol-studio",
        "aliases": [
          "Portugol Studio",
          "portugol-studio"
        ],
        "extensions": [
          ".por"
        ],
        "configuration": "./syntaxes/portugol-studio.language-configuration.json"
      }
    ]
  },
  "scripts": {
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "npm run build && vsce package",
    "publish-core": "dotnet publish ../../core/MultiLingualCode.Core.Host/MultiLingualCode.Core.Host.csproj -c Release -p:UseAppHost=false -o bin",
    "publish-core:self-contained": "dotnet publish ../../core/MultiLingualCode.Core.Host/MultiLingualCode.Core.Host.csproj -c Release -r \"$DOTNET_RID\" --self-contained true -o bin",
    "prepackage": "npm run publish-core && npm run copy-translations && npm run copy-readme",
    "copy-translations": "node ../../../scripts/copy-translations.js",
    "copy-readme": "node ../../../scripts/copy-readme.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "esbuild": "^0.25.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.2"
  }
}
